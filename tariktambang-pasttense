<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tarik Tambang: Simple Past Tense Battle</title>
    <style>
        :root {
            --sky: #87CEEB;
            --grass: #4CAF50;
            --rope: #8B4513;
            --left-team: #3498db;
            --right-team: #e74c3c;
            --ui-bg: rgba(255, 255, 255, 0.95);
        }

        * { box-sizing: border-box; user-select: none; }
        
        body {
            margin: 0; padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(to bottom, var(--sky) 60%, var(--grass) 60%);
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* HEADER & SCORE */
        header {
            width: 100%; max-width: 800px;
            display: flex; justify-content: space-between; align-items: center;
            padding: 15px 20px; color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
            z-index: 10;
        }
        .team-score { font-size: 1.5rem; font-weight: bold; }
        .turn-indicator { 
            background: rgba(0,0,0,0.6); padding: 8px 20px; 
            border-radius: 20px; font-size: 1.1rem; 
            transition: all 0.3s;
        }

        /* GAME AREA */
        .arena {
            position: relative;
            width: 95%; max-width: 900px;
            height: 250px;
            margin-top: 10px;
        }

        .center-line {
            position: absolute; left: 50%; top: 60%; bottom: 0;
            width: 4px; background: white; transform: translateX(-50%);
            opacity: 0.7;
        }

        .rope-container {
            position: absolute; top: 58%; left: 50%;
            width: 0; height: 12px;
            transform: translateX(-50%);
            transition: left 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
            z-index: 5;
        }

        .rope {
            position: absolute; left: -300px; top: 0;
            width: 600px; height: 12px;
            background: repeating-linear-gradient(90deg, var(--rope), var(--rope) 15px, #A0522D 15px, #A0522D 30px);
            border-radius: 6px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        }

        .character {
            position: absolute; top: -70px; font-size: 70px;
            filter: drop-shadow(0 5px 5px rgba(0,0,0,0.3));
            transition: transform 0.3s;
        }
        .char-left { left: -360px; transform: scaleX(-1); }
        .char-right { right: -360px; }
        
        .pulling { animation: pullAnim 0.5s ease-in-out infinite alternate; }
        @keyframes pullAnim { from { transform: scaleX(-1) translateY(0); } to { transform: scaleX(-1) translateY(-5px); } }
        .char-right.pulling { animation-name: pullAnimRight; }
        @keyframes pullAnimRight { from { transform: translateY(0); } to { transform: translateY(-5px); } }

        /* QUIZ PANEL */
        .quiz-panel {
            margin-top: 20px;
            background: var(--ui-bg);
            width: 90%; max-width: 650px;
            padding: 25px; border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            text-align: center;
            z-index: 20;
            border-top: 5px solid #ccc;
            transition: border-color 0.3s;
        }

        .q-label { 
            display: inline-block; padding: 5px 15px; 
            border-radius: 15px; color: white; font-weight: bold; 
            margin-bottom: 10px; font-size: 0.9rem;
        }

        .question-text { font-size: 1.4rem; margin-bottom: 20px; color: #2c3e50; }

        .options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        
        .opt-btn {
            padding: 15px; font-size: 1.1rem;
            border: 2px solid #ddd; background: white;
            border-radius: 10px; cursor: pointer;
            transition: all 0.2s; font-weight: 600;
        }
        .opt-btn:hover:not(:disabled) { background: #f0f0f0; transform: translateY(-2px); }
        .opt-btn:disabled { cursor: not-allowed; opacity: 0.7; }
        
        .opt-btn.correct { background: #2ecc71 !important; color: white; border-color: #27ae60; }
        .opt-btn.wrong { background: #e74c3c !important; color: white; border-color: #c0392b; }

        /* MODAL */
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            display: flex; justify-content: center; align-items: center;
            z-index: 100; opacity: 0; pointer-events: none;
            transition: opacity 0.3s;
        }
        .modal-overlay.active { opacity: 1; pointer-events: auto; }
        
        .modal-content {
            background: white; padding: 40px; border-radius: 20px;
            text-align: center; max-width: 450px; width: 90%;
            transform: scale(0.8); transition: transform 0.3s;
        }
        .modal-overlay.active .modal-content { transform: scale(1); }
        
        .modal-title { font-size: 2rem; margin-bottom: 10px; }
        .modal-msg { font-size: 1.2rem; color: #555; margin-bottom: 25px; }
        
        .btn-primary {
            padding: 15px 40px; font-size: 1.2rem; font-weight: bold;
            background: var(--grass); color: white; border: none;
            border-radius: 50px; cursor: pointer;
            box-shadow: 0 5px 15px rgba(76,175,80,0.4);
        }

        @media (max-width: 600px) {
            .options-grid { grid-template-columns: 1fr; }
            .character { font-size: 50px; top: -55px; }
            .char-left { left: -280px; }
            .char-right { right: -280px; }
            .rope { width: 500px; left: -250px; }
            .question-text { font-size: 1.1rem; }
        }
    </style>
</head>
<body>

<header>
    <div class="team-score" style="color: var(--left-team);">👦 TIM KIRI</div>
    <div class="turn-indicator" id="turnIndicator">Giliran: TIM KIRI</div>
    <div class="team-score" style="color: var(--right-team);">TIM KANAN 👧</div>
</header>

<div class="arena">
    <div class="center-line"></div>
    <div class="rope-container" id="ropeContainer">
        <div class="rope"></div>
        <div class="character char-left" id="charLeft">🏃‍♂️</div>
        <div class="character char-right" id="charRight">🏃‍♀️</div>
    </div>
</div>

<div class="quiz-panel" id="quizPanel">
    <div class="q-label" id="qLabel">Soal 1 - Tim Kiri</div>
    <div class="question-text" id="qText">Loading...</div>
    <div class="options-grid" id="optsContainer"></div>
</div>

<!-- START / END MODAL -->
<div class="modal-overlay active" id="gameModal">
    <div class="modal-content">
        <div class="modal-title" id="modalTitle">🪢 Tarik Tambang</div>
        <div class="modal-msg" id="modalMsg">Simple Past Tense Battle<br>Jawab benar untuk menarik tali!</div>
        <button class="btn-primary" id="modalBtn" onclick="startGame()">MULAI GAME</button>
    </div>
</div>

<script>
/**
 * DATA SOAL SIMPLE PAST TENSE
 * 5 Pasangan soal dengan topik grammar yang sama
 */
const QUESTION_PAIRS = [
    { // 1. Regular Verb Positive
        left: { q: "She ___ fried rice yesterday.", opts: ["cook", "cooked", "cooks", "cooking"], ans: 1 },
        right: { q: "He ___ football last Sunday.", opts: ["play", "plays", "played", "playing"], ans: 2 }
    },
    { // 2. Irregular Verb Positive
        left: { q: "They ___ to Bandung last month.", opts: ["go", "went", "gone", "going"], ans: 1 },
        right: { q: "We ___ a new car two days ago.", opts: ["buy", "bought", "buys", "buying"], ans: 1 }
    },
    { // 3. Negative Sentence (didn't + V1)
        left: { q: "I ___ not watch TV last night.", opts: ["do", "did", "does", "done"], ans: 1 },
        right: { q: "She ___ not eat breakfast this morning.", opts: ["do", "did", "does", "was"], ans: 1 }
    },
    { // 4. Interrogative (Did + S + V1)
        left: { q: "___ you visit your grandmother last week?", opts: ["Do", "Does", "Did", "Were"], ans: 2 },
        right: { q: "___ they finish the homework yesterday?", opts: ["Did", "Do", "Was", "Are"], ans: 0 }
    },
    { // 5. To Be Past (Was/Were)
        left: { q: "My mother ___ sick yesterday.", opts: ["is", "are", "was", "were"], ans: 2 },
        right: { q: "The students ___ happy at the party last night.", opts: ["was", "were", "is", "are"], ans: 1 }
    }
];

/**
 * AUDIO SYSTEM (Web Audio API)
 */
const Audio = (() => {
    let ctx = null;
    const init = () => { if(!ctx) ctx = new (window.AudioContext || window.webkitAudioContext)(); };
    
    const tone = (freq, type, dur, vol=0.1) => {
        if(!ctx) return;
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = type; o.frequency.value = freq;
        g.gain.setValueAtTime(vol, ctx.currentTime);
        g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);
        o.connect(g); g.connect(ctx.destination);
        o.start(); o.stop(ctx.currentTime + dur);
    };

    return {
        init,
        correct: () => { tone(523,'sine',0.1,0.2); setTimeout(()=>tone(659,'sine',0.1,0.2),100); setTimeout(()=>tone(784,'sine',0.3,0.2),200); },
        wrong: () => { tone(200,'sawtooth',0.2,0.2); setTimeout(()=>tone(150,'sawtooth',0.3,0.2),150); },
        win: () => { [523,659,784,1047].forEach((f,i) => setTimeout(()=>tone(f,'square',0.3,0.15), i*150)); },
        pull: () => tone(100, 'triangle', 0.1, 0.05)
    };
})();

/**
 * GAME STATE
 */
let state = {
    round: 0,       // 0-4 (index pasangan soal)
    isLeftTurn: true,
    ropePos: 50,    // Persentase dari kiri (50 = tengah)
    totalQuestions: 10,
    answeredCount: 0,
    isProcessing: false
};

const SHIFT = 10; // Pergeseran tali per jawaban (%)
const WIN_THRESHOLD = 15; // Posisi <=15 atau >=85 = Menang Instan

// DOM Elements
const ropeContainer = document.getElementById('ropeContainer');
const turnIndicator = document.getElementById('turnIndicator');
const quizPanel = document.getElementById('quizPanel');
const qLabel = document.getElementById('qLabel');
const qText = document.getElementById('qText');
const optsContainer = document.getElementById('optsContainer');
const charLeft = document.getElementById('charLeft');
const charRight = document.getElementById('charRight');
const modal = document.getElementById('gameModal');

function startGame() {
    Audio.init();
    state = { round: 0, isLeftTurn: true, ropePos: 50, totalQuestions: 10, answeredCount: 0, isProcessing: false };
    updateRopeVisual();
    modal.classList.remove('active');
    loadCurrentQuestion();
}

function loadCurrentQuestion() {
    if (state.answeredCount >= state.totalQuestions || state.ropePos <= WIN_THRESHOLD || state.ropePos >= (100 - WIN_THRESHOLD)) {
        endGame();
        return;
    }

    const pair = QUESTION_PAIRS[state.round];
    const qData = state.isLeftTurn ? pair.left : pair.right;
    const teamName = state.isLeftTurn ? "TIM KIRI 👦" : "TIM KANAN 👧";
    const teamColor = state.isLeftTurn ? "var(--left-team)" : "var(--right-team)";

    // Update UI Indikator
    turnIndicator.innerText = `Giliran: ${teamName}`;
    turnIndicator.style.background = teamColor;
    quizPanel.style.borderTopColor = teamColor;
    qLabel.innerText = `Soal ${state.answeredCount + 1}/10 - ${state.isLeftTurn ? 'Tim Kiri' : 'Tim Kanan'}`;
    qLabel.style.background = teamColor;
    qText.innerText = qData.q;

    // Render Opsi
    optsContainer.innerHTML = '';
    qData.opts.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = 'opt-btn';
        btn.innerText = opt;
        btn.onclick = () => handleAnswer(idx, qData.ans, btn);
        optsContainer.appendChild(btn);
    });

    state.isProcessing = false;
}

function handleAnswer(selectedIdx, correctIdx, btnElement) {
    if (state.isProcessing) return;
    state.isProcessing = true;

    const allBtns = optsContainer.querySelectorAll('.opt-btn');
    allBtns.forEach(b => b.disabled = true);

    const isCorrect = selectedIdx === correctIdx;
    
    // Visual Feedback Tombol
    if (isCorrect) {
        btnElement.classList.add('correct');
        Audio.correct();
    } else {
        btnElement.classList.add('wrong');
        // Tunjukkan yang benar
        allBtns[correctIdx].classList.add('correct');
        Audio.wrong();
    }

    // Logika Pergeseran Tali
    setTimeout(() => {
        Audio.pull();
        
        if (state.isLeftTurn) {
            // Tim Kiri: Benar = Geser Kiri (kurangi), Salah = Geser Kanan (tambah)
            state.ropePos += isCorrect ? -SHIFT : SHIFT;
            animatePull(isCorrect ? 'left' : 'right');
        } else {
            // Tim Kanan: Benar = Geser Kanan (tambah), Salah = Geser Kiri (kurangi)
            state.ropePos += isCorrect ? SHIFT : -SHIFT;
            animatePull(isCorrect ? 'right' : 'left');
        }

        // Clamp posisi
        state.ropePos = Math.max(0, Math.min(100, state.ropePos));
        updateRopeVisual();

        state.answeredCount++;
        
        // Ganti Giliran
        if (!state.isLeftTurn) state.round++; // Round bertambah setelah kedua tim menjawab
        state.isLeftTurn = !state.isLeftTurn;

        setTimeout(loadCurrentQuestion, 1200);
    }, 800);
}

function animatePull(direction) {
    const char = direction === 'left' ? charLeft : charRight;
    char.classList.add('pulling');
    setTimeout(() => char.classList.remove('pulling'), 600);
}

function updateRopeVisual() {
    ropeContainer.style.left = state.ropePos + '%';
}

function endGame() {
    let winner = "";
    let msg = "";
    let color = "";

    if (state.ropePos <= WIN_THRESHOLD) {
        winner = "👦 TIM KIRI MENANG! 🎉";
        msg = "Tim Kiri berhasil menarik tali hingga mentok!";
        color = "var(--left-team)";
    } else if (state.ropePos >= (100 - WIN_THRESHOLD)) {
        winner = "👧 TIM KANAN MENANG! 🎉";
        msg = "Tim Kanan berhasil menarik tali hingga mentok!";
        color = "var(--right-team)";
    } else {
        // Waktu habis (semua soal terjawab) tapi belum mentok
        if (state.ropePos < 50) {
            winner = "👦 TIM KIRI MENANG!";
            msg = "Posisi tali lebih dekat ke sisi Tim Kiri.";
            color = "var(--left-team)";
        } else if (state.ropePos > 50) {
            winner = "👧 TIM KANAN MENANG!";
            msg = "Posisi tali lebih dekat ke sisi Tim Kanan.";
            color = "var(--right-team)";
        } else {
            winner = "SERI! 🤝";
            msg = "Kedua tim sama kuatnya!";
            color = "#555";
        }
    }

    Audio.win();
    document.getElementById('modalTitle').innerText = winner;
    document.getElementById('modalTitle').style.color = color;
    document.getElementById('modalMsg').innerHTML = `${msg}<br><small>Posisi Akhir Tali: ${Math.round(state.ropePos)}%</small>`;
    document.getElementById('modalBtn').innerText = "MAIN LAGI";
    modal.classList.add('active');
}
</script>
</body>
</html>
